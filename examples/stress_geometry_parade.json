{
  "canvas": {
    "width": 1024,
    "height": 576,
    "background": "#0a0510"
  },
  "camera": {
    "position": [0, 5, 15],
    "target": [0, 0, 0],
    "fov": 50
  },
  "duration": 8.0,
  "fps": 30,
  "elements": [
    {
      "type": "grid",
      "divisions": 50,
      "fade_distance": 60,
      "color": "#220044",
      "opacity": 0.3
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [-6, 1, 0],
      "rotation": { "y": "t * 360", "x": "sin(t * PI * 2) * 30" },
      "scale": "smoothstep(t, 0.0, 0.125)",
      "color": "#ff0044",
      "thickness": 2.0,
      "opacity": "step(t, 0.0) * (1 - step(t, 0.875))"
    },
    {
      "type": "wireframe",
      "geometry": "sphere",
      "position": [-4, 1, 0],
      "rotation": { "x": "t * 180" },
      "scale": "smoothstep(t, 0.0625, 0.1875)",
      "color": "#ff4400",
      "thickness": 1.5,
      "opacity": "step(t, 0.0625) * (1 - step(t, 0.9375))"
    },
    {
      "type": "wireframe",
      "geometry": "torus",
      "position": [-2, 1, 0],
      "rotation": { "x": "t * 90", "z": "t * 180" },
      "scale": "smoothstep(t, 0.125, 0.25)",
      "color": "#ffaa00",
      "thickness": 1.5,
      "opacity": "step(t, 0.125) * (1 - step(t, 0.875))"
    },
    {
      "type": "wireframe",
      "geometry": "ico",
      "position": [0, 1, 0],
      "rotation": { "y": "t * 540" },
      "scale": "smoothstep(t, 0.1875, 0.3125)",
      "color": "#88ff00",
      "thickness": 1.5,
      "opacity": "step(t, 0.1875) * (1 - step(t, 0.8125))"
    },
    {
      "type": "wireframe",
      "geometry": "cylinder",
      "position": [2, 1, 0],
      "rotation": { "x": "t * 360" },
      "scale": "smoothstep(t, 0.25, 0.375)",
      "color": "#00ff88",
      "thickness": 1.5,
      "opacity": "step(t, 0.25) * (1 - step(t, 0.75))"
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [4, 1, 0],
      "rotation": { "y": "t * -360", "z": "t * 180" },
      "scale": "smoothstep(t, 0.3125, 0.4375)",
      "color": "#00ffff",
      "thickness": 2.0,
      "opacity": "step(t, 0.3125) * (1 - step(t, 0.6875))"
    },
    {
      "type": "wireframe",
      "geometry": "sphere",
      "position": [6, 1, 0],
      "rotation": { "y": "t * 270" },
      "scale": "smoothstep(t, 0.375, 0.5)",
      "color": "#0088ff",
      "thickness": 1.5,
      "opacity": "step(t, 0.375) * (1 - step(t, 0.625))"
    },
    {
      "type": "wireframe",
      "geometry": "torus",
      "position": [-6, 1, -3],
      "rotation": { "y": "t * 180" },
      "scale": "smoothstep(t, 0.4375, 0.5625)",
      "color": "#4400ff",
      "thickness": 1.5,
      "opacity": "step(t, 0.4375) * (1 - step(t, 0.5625))"
    },
    {
      "type": "wireframe",
      "geometry": "ico",
      "position": [6, 1, -3],
      "rotation": { "x": "t * 360", "z": "t * 180" },
      "scale": "smoothstep(t, 0.5, 0.625)",
      "color": "#aa00ff",
      "thickness": 1.5,
      "opacity": "step(t, 0.5) * (1 - step(t, 0.5))"
    },
    {
      "type": "axes",
      "length": 2.0,
      "thickness": 1.5,
      "position": [0, 0, 0],
      "opacity": "if_else(t < 0.5, smoothstep(t, 0.4, 0.5), smoothstep(1 - t, 0.4, 0.5))"
    },
    {
      "type": "line",
      "points": [[-8, 0, 0], [8, 0, 0]],
      "color": "#ffffff",
      "thickness": 1.0,
      "opacity": "smoothstep(t, 0.0, 0.1) * smoothstep(1 - t, 0.0, 0.1) * 0.3"
    },
    {
      "type": "glyph",
      "text": "GEOMETRY PARADE",
      "font_size": 0.3,
      "position": [0, 4, 0],
      "color": "#ffffff",
      "opacity": "smoothstep(t, 0.0, 0.05)",
      "animation": "type"
    },
    {
      "type": "glyph",
      "text": "cube  sphere  torus  ico  cylinder",
      "font_size": 0.12,
      "position": [0, -2, 0],
      "color": "#666666",
      "opacity": "smoothstep(t, 0.1, 0.2)"
    },
    {
      "type": "particles",
      "count": 100,
      "bounds": [25, 12, 20],
      "size": 0.8,
      "color": "#8866ff",
      "opacity": 0.25,
      "depth_fade": true
    }
  ],
  "post": {
    "bloom": 0.35,
    "scanlines": { "intensity": 0.08, "count": 288 },
    "chromatic_aberration": 0.002,
    "noise": 0.025,
    "vignette": 0.35
  }
}
