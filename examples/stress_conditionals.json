{
  "canvas": {
    "width": 800,
    "height": 600,
    "background": "#020208"
  },
  "camera": {
    "position": [6, 4, 6],
    "target": [0, 0, 0],
    "fov": 55
  },
  "duration": 4.0,
  "fps": 30,
  "elements": [
    {
      "type": "grid",
      "divisions": 30,
      "fade_distance": 40,
      "color": "#003366",
      "opacity": "smoothstep(t, 0.0, 0.2)"
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [-2, 0.5, 0],
      "rotation": { "y": "t * 360" },
      "scale": "if_else(t < 0.5, 0.5 + t, 1.5 - t)",
      "color": "#ff0066",
      "thickness": 2.0,
      "opacity": "if_else(t < 0.25, t * 4, if_else(t < 0.75, 1.0, (1 - t) * 4))"
    },
    {
      "type": "wireframe",
      "geometry": "sphere",
      "position": [0, 0.5, 0],
      "rotation": { "x": "t * 180", "y": "t * 270" },
      "scale": "smoothstep(t, 0.0, 0.5) * 0.8 + 0.2",
      "color": "#00ff99",
      "thickness": 1.5,
      "opacity": "smoothstep(t, 0.1, 0.3) * (1 - smoothstep(t, 0.7, 0.9))"
    },
    {
      "type": "wireframe",
      "geometry": "torus",
      "position": [2, 0.5, 0],
      "rotation": { "z": "t * 360" },
      "scale": "step(t, 0.5) * 0.5 + 0.5",
      "color": "#ffcc00",
      "thickness": 2.0,
      "opacity": "1 - step(t, 0.8)"
    },
    {
      "type": "wireframe",
      "geometry": "ico",
      "position": [0, 2.5, 0],
      "rotation": {
        "x": "if_else(t < 0.5, t * 360, 180)",
        "y": "t * 720",
        "z": "smoothstep(t, 0.3, 0.7) * 90"
      },
      "scale": 0.6,
      "color": "#00ccff",
      "thickness": 1.5,
      "opacity": "if_else(sin(t * PI * 4) > 0, 0.9, 0.3)"
    },
    {
      "type": "line",
      "points": [[-3, 0, 0], [3, 0, 0]],
      "color": "#ffffff",
      "thickness": 1.0,
      "opacity": "step(t, 0.1) * step(0.9, 1 - t) * 0.5"
    },
    {
      "type": "line",
      "points": [[0, -1, -3], [0, -1, 3]],
      "color": "#ffffff",
      "thickness": 1.0,
      "opacity": "step(t, 0.2) * step(0.8, 1 - t) * 0.5"
    },
    {
      "type": "glyph",
      "text": "CONDITIONAL TEST",
      "font_size": 0.2,
      "position": [0, 4, 0],
      "color": "#00ffcc",
      "opacity": "smoothstep(t, 0.0, 0.1)",
      "animation": "type"
    },
    {
      "type": "glyph",
      "text": "if_else | step | smoothstep",
      "font_size": 0.12,
      "position": [0, -2.5, 0],
      "color": "#666688",
      "opacity": "if_else(t < 0.5, t * 2, 1.0)"
    },
    {
      "type": "particles",
      "count": 60,
      "bounds": [15, 10, 15],
      "size": 1.2,
      "color": "#4488ff",
      "opacity": "smoothstep(t, 0.0, 0.3) * 0.4",
      "depth_fade": true
    }
  ],
  "post": {
    "bloom": 0.4,
    "scanlines": { "intensity": 0.1, "count": 300 },
    "chromatic_aberration": 0.003,
    "noise": 0.03,
    "vignette": 0.4
  }
}
