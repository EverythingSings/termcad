{
  "canvas": {
    "width": 640,
    "height": 480,
    "background": "#030308"
  },
  "camera": {
    "position": [0, 3, 8],
    "target": [0, 1.5, 0],
    "fov": 50
  },
  "duration": 4.0,
  "fps": 24,
  "elements": [
    {
      "type": "grid",
      "divisions": 40,
      "fade_distance": 50,
      "color": "#0044aa",
      "opacity": 0.2
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [-2, 1, 0],
      "rotation": { "y": "t * 180" },
      "scale": 0.8,
      "color": "#00ffff",
      "thickness": 2.0,
      "opacity": "sin(t * PI)"
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [0, 1, 0],
      "rotation": { "y": "t * 180 + 60" },
      "scale": 0.8,
      "color": "#00ffff",
      "thickness": 2.0,
      "opacity": "sin(t * PI + PI / 3)"
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [2, 1, 0],
      "rotation": { "y": "t * 180 + 120" },
      "scale": 0.8,
      "color": "#00ffff",
      "thickness": 2.0,
      "opacity": "sin(t * PI + PI * 2 / 3)"
    },
    {
      "type": "wireframe",
      "geometry": "sphere",
      "position": [-2, 1, 0],
      "rotation": { "x": "t * 90" },
      "scale": 0.5,
      "color": "#ffffff",
      "thickness": 1.0,
      "opacity": "cos(t * PI)"
    },
    {
      "type": "wireframe",
      "geometry": "sphere",
      "position": [0, 1, 0],
      "rotation": { "x": "t * 90" },
      "scale": 0.5,
      "color": "#ffffff",
      "thickness": 1.0,
      "opacity": "cos(t * PI + PI / 3)"
    },
    {
      "type": "wireframe",
      "geometry": "sphere",
      "position": [2, 1, 0],
      "rotation": { "x": "t * 90" },
      "scale": 0.5,
      "color": "#ffffff",
      "thickness": 1.0,
      "opacity": "cos(t * PI + PI * 2 / 3)"
    },
    {
      "type": "line",
      "points": [[-3, 0.1, 0], [3, 0.1, 0]],
      "color": "#0066ff",
      "thickness": 1.5,
      "opacity": "sin(t * PI * 3) * 0.3 + 0.4"
    },
    {
      "type": "particles",
      "count": 25,
      "bounds": [25, 15, 20],
      "size": 1.0,
      "color": "#ffffff",
      "opacity": 0.2,
      "depth_fade": true
    },
    {
      "type": "glyph",
      "text": "sig.ghost.001",
      "font_size": 0.14,
      "position": [-4.5, -2.2, 0],
      "color": "#0066ff",
      "opacity": 0.5
    },
    {
      "type": "glyph",
      "text": "PHASE SHIFT",
      "font_size": 0.18,
      "position": [0, 3.2, 0],
      "color": "#00ffff",
      "opacity": "sin(t * PI) * 0.5 + 0.5",
      "animation": "flicker"
    }
  ],
  "post": {
    "bloom": 0.45,
    "scanlines": { "intensity": 0.15, "count": 240 },
    "chromatic_aberration": 0.006,
    "noise": 0.06,
    "vignette": 0.6
  }
}
