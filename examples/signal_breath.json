      "color": "#00ffff",
      "thickness": 2.0,
      "opacity": "sin(t * PI * 2) * 0.4 + 0.6"
    },
    {
      "type": "wireframe",
      "geometry": "ico",
      "position": [0, 1.5, 0],
      "rotation": { "y": "t * -80", "z": "t * 40" },
