      "color": "#ffffff",
      "thickness": 1.5,
      "opacity": "cos(t * PI * 2) * 0.4 + 0.6"
    },
    {
      "type": "line",
      "points": [[0, 1.5, 0], [0, 4, 0]],
      "color": "#00ffff",
      "thickness": 2.0,
      "opacity": "sin(t * PI * 4) * 0.5 + 0.5"
    },
    {
      "type": "line",
      "points": [[0, 1.5, 0], [2.5, 1.5, 0]],
      "color": "#0066ff",
      "thickness": 1.5,
