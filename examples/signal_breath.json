{
  "canvas": {
    "width": 640,
    "height": 480,
    "background": "#030308"
  },
  "camera": {
    "position": [6, 4, 6],
    "target": [0, 1, 0],
    "fov": 45
  },
  "duration": 3.0,
  "fps": 24,
  "elements": [
    {
      "type": "grid",
      "divisions": 40,
      "fade_distance": 50,
