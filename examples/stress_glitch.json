{
  "canvas": {
    "width": 640,
    "height": 480,
    "background": "#080808"
  },
  "camera": {
    "position": [5, 3, 5],
    "target": [0, 0, 0],
    "fov": 50
  },
  "duration": 3.0,
  "fps": 30,
  "elements": [
    {
      "type": "grid",
      "divisions": 20,
      "fade_distance": 30,
      "color": "#004400",
      "opacity": "if_else(sin(t * PI * 20) > 0.95, 0.8, 0.2)"
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [0, 0.5, 0],
      "rotation": {
        "y": "if_else(sin(t * PI * 15) > 0.9, t * 360 + 45, t * 360)",
        "x": "if_else(sin(t * PI * 12) > 0.85, 15.0, 0.0)",
        "z": "if_else(sin(t * PI * 18) > 0.92, -10.0, 0.0)"
      },
      "scale": "if_else(sin(t * PI * 25) > 0.97, 1.3, 1.0)",
      "color": "#00ff00",
      "thickness": 2.0,
      "opacity": "if_else(sin(t * PI * 30) > 0.98, 0.3, 1.0)"
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [0.05, 0.5, 0],
      "rotation": { "y": "t * 360" },
      "scale": 1.0,
      "color": "#ff0000",
      "thickness": 1.0,
      "opacity": "if_else(sin(t * PI * 22) > 0.9, 0.4, 0.0)"
    },
    {
      "type": "wireframe",
      "geometry": "cube",
      "position": [-0.05, 0.5, 0],
      "rotation": { "y": "t * 360" },
      "scale": 1.0,
      "color": "#0000ff",
      "thickness": 1.0,
      "opacity": "if_else(sin(t * PI * 17) > 0.88, 0.4, 0.0)"
    },
    {
      "type": "line",
      "points": [[-3, 2.5, 0], [3, 2.5, 0]],
      "color": "#ff0000",
      "thickness": 2.0,
      "opacity": "if_else(sin(t * PI * 35) > 0.96, 0.8, 0.1)"
    },
    {
      "type": "line",
      "points": [[-3, -1.5, 0], [3, -1.5, 0]],
      "color": "#00ff00",
      "thickness": 2.0,
      "opacity": "if_else(sin(t * PI * 28) > 0.94, 0.7, 0.1)"
    },
    {
      "type": "glyph",
      "text": "ERROR",
      "font_size": 0.3,
      "position": [0, 3, 0],
      "color": "#ff0000",
      "opacity": "if_else(sin(t * PI * 40) > 0.92, 1.0, 0.0)",
      "animation": "flicker"
    },
    {
      "type": "glyph",
      "text": "SIGNAL CORRUPT",
      "font_size": 0.15,
      "position": [0, -2.5, 0],
      "color": "#00ff00",
      "opacity": "if_else(sin(t * PI * 8) > 0.0, 0.6, 0.2)",
      "animation": "flicker"
    },
    {
      "type": "glyph",
      "text": "0x4552524F52",
      "font_size": 0.1,
      "position": [2.5, 2, 0],
      "color": "#666666",
      "opacity": "step(t, 0.5) * if_else(sin(t * PI * 50) > 0.9, 0.8, 0.3)"
    },
    {
      "type": "particles",
      "count": 40,
      "bounds": [12, 8, 12],
      "size": 1.5,
      "color": "#00ff00",
      "opacity": "if_else(sin(t * PI * 45) > 0.95, 0.6, 0.2)",
      "depth_fade": true
    }
  ],
  "post": {
    "bloom": 0.5,
    "scanlines": { "intensity": 0.25, "count": 240 },
    "chromatic_aberration": 0.01,
    "noise": 0.08,
    "vignette": 0.5,
    "crt_curvature": 0.15
  }
}
